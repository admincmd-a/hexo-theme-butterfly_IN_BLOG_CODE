#footer
  position: relative
  // background-color: $color-theme-light-main
  background-attachment: scroll
  background-position: bottom
  background-size: cover

  if false/*hexo-config('footer.enable') != false && hexo-config('mask.footer')*/
    &:before
      position: absolute
      width: 100%
      height: 100%
      background-color: var(--mark-bg)
      content: ''
html[data-theme="dark"] #footer
  background-color: $color-theme-dark-main
html[data-theme="light"] #footer
  background-color: $color-theme-light-main
#footer-wrap
  position: relative
  padding: 40px 20px
  color: var(--light-grey)
  text-align: center

  a
    color: var(--light-grey)

    &:hover
      text-decoration: underline

  .footer-separator
    margin: 0 4px

  .icp-icon
    padding: 0 4px
    max-height: 1.4em
    width: auto
    vertical-align: text-bottom
