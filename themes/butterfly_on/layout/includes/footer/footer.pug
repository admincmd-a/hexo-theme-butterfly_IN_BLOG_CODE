#footer-wrap
  if theme.footer.owner.enable
    - var now = new Date()
    - var nowYear = now.getFullYear()
    if theme.footer.owner.since && theme.footer.owner.since != nowYear
      .copyright!= `&copy;${theme.footer.owner.since} - ${nowYear} By ${config.author}`
    else
      .copyright!= `&copy;${nowYear} By ${config.author}`
  if theme.footer.copyright
    .framework-info
      //- 动态生成标签
      each key in Object.keys(theme.footer.tage.item)
        if theme.footer.tage.enable 
          - var item = theme.footer.tage.item[key]
          if item.html
            //- 自定义 HTML 模式
            != item.html
            span.footer-separator |
          else
            //- 常规标签模式
            if key && key.trim() !== ''
              span= _p(key) + ' '
            a(
              href=item.url || 'javascript:void(0)'
              title=item.title
              target=item.target
              rel=item.rel
            )&attributes(item.attrs || {})
              //- 图标和图片处理
              if item.ico
                i(class=item.ico)
              if item.image
                img(
                  src=item.image
                  alt=item.alt || ' '
                  style=item.imageStyle
                )&attributes(item.imgAttrs || {})
              = item.text
            //- 分隔符（最后一个标签不需要可以在此处理）
            if key !== Object.keys(theme.footer.tage.item)[Object.keys(theme.footer.tage.item).length]
              span.footer-separator |
        else 
          //- 无标签模式
      if theme.footer.c51la.enable && theme.footer.c51la.ld != ``
        br
        //- 统计脚本
        script#LA-DATA-WIDGET(
          src=`https://v6-widget.51.la/v6/${theme.footer.c51la.id}/quote.js?${theme.footer.c51la.theme}`
          charset="UTF-8"
          crossorigin="anonymous"
        )
  if theme.footer.custom_text
    .footer_custom_text!=`${theme.footer.custom_text}`


  if theme.footer.time_line.enable
    time-line
      head
        style.
          
      body
        footer#footer
          #workboard
        script.
          var grt = new Date('#{theme.footer.time_line.start_time}');
          var dnum, hnum, mnum, snum, nowHour, t, n;

          function updateTime() {
            now = new Date();
            nowHour = now.getHours();
            var days = (now - grt) / 1000 / 60 / 60 / 24;
            dnum = Math.floor(days);
            var hours = (now - grt) / 1000 / 60 / 60 - 24 * dnum;
            hnum = Math.floor(hours);
            hnum = String(hnum).padStart(2, '0');

            var minutes = (now - grt) / 1000 / 60 - 24 * 60 * dnum - 60 * hnum;
            mnum = Math.floor(minutes);
            mnum = String(mnum).padStart(2, '0');

            var seconds = (now - grt) / 1000 - 24 * 60 * 60 * dnum - 60 * 60 * hnum - 60 * mnum;
            snum = Math.round(seconds);
            snum = String(snum).padStart(2, '0');

            t = Math.trunc(234e8 + (now - grt) / 1e3 * 17);
            n = (t / 1496e5).toFixed(6);
          }

          function updateHtml() {
            const footer = document.getElementById("footer");
            if (!footer) return;

            let currentTimeHtml = `
              <div id="runtimeTextTip">
                #{theme.footer.time_line.message_prev} ${dnum} #{theme.footer.time_line.message_next}
                <span id='runtime'>${hnum} 小时 ${mnum} 分 ${snum} 秒</span>
                <i class='haofont hao-icon-heartbeat' style='color:red'></i>
                <br>
                旅行者 1 号现在距离地球 ${t} 千米了，差不多是 ${n} 个地球到太阳的距离 (天文单位)
              </div>`;

            if (document.getElementById("workboard")) {
              document.getElementById("workboard").innerHTML = currentTimeHtml;
            }
          }

          setInterval(() => {
            updateTime();
            updateHtml();
          }, 1000);


