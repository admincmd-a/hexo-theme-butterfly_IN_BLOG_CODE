doctype html

- var htmlClassHideAside = theme.aside.enable && theme.aside.hide ? 'hide-aside' : ''
- page.aside = is_archive() ? theme.aside.display.archive: is_category() ? theme.aside.display.category : is_tag() ? theme.aside.display.tag : page.aside
- var hideAside = !theme.aside.enable || page.aside === false ? 'hide-aside' : ''
- var pageType = is_post() ? 'post' : 'page'


html(lang=config.language data-theme=theme.display_mode class=htmlClassHideAside)
  head

    include ./head.pug
    !=partial('includes/other_head',{}, {cache:true})
  body
    !=partial('includes/load',{}, {cache:true})
    //- 在设置等'窗口'打开时，对#WED进行操作即可,任何需要作为网页基本元素都需要放在#WED中
    div(id="page-main" class="page-main")
      if theme.preloader.enable
        !=partial('includes/loading/index', {}, {cache: true})

      if theme.background
        #web_bg

      !=partial('includes/sidebar', {}, {cache: true})

      if page.type !== '404'
        //- 不在404页面所加载的
        #body-wrap(class=pageType)
          include ./header/index.pug

          main#content-inner.layout(class=hideAside)
            if body
              div!= body
            else
              block content
              if theme.aside.enable && page.aside !== false
                include widget/index.pug

      - var back_ground = theme.footer.background
      if (theme.footer.enable)
        footer#footer()
          !=partial('includes/footer/footer', {}, {cache: true})
      //- - var back_ground = isImgOrUrl(theme.footer.back_ground.img) ? `background-image: url('${url_for(footerBg)}')` : `background: ${back_ground.color}`
      //- footer#footer(style=isImgOrUrl(theme.footer.background.img) ? `background-image: url('${url_for(back_ground.image)}')` : `background: ${back_ground.color}`)
      //-   !=partial('includes/footer/footer', {}, {cache: true})

          

      else
        include ./404.pug

      include ./rightside.pug
      
      
    if page.type !== '404'

    div(id="sett" class="sett" style="display:none")
    !=partial('includes/rightmenu',{}, {cache:true})
    !=partial('includes/aaa',{}, {cache:true})
    !=partial('includes/other_boby',{}, {cache:true})
    !=partial('/includes/welcomemap',{}, {cache:true})
    !=partial('includes/aplayer',{}, {cache:true})

    script(src="/js/LunarCalendar.js")
    script(src="/js/i.js")

    !=partial('includes/mainJs',{}, {cache:true})
    include ./additional-js.pug

    !=partial('includes/configwin/main',{}, {cache:true})
  