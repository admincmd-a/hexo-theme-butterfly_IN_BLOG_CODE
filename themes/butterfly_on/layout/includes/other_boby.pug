            AUTHOR_LATITUDE: "#{theme.welcomemap.author_latitude}",
            AUTHOR_ADDRESS: "#{theme.welcomemap.author_address}",
            DEFAULT_ADDRESS: "#{theme.welcomemap.default_address}",
            INFO_IP_ENABLE: #{theme.welcomemap.ip.enable},
            INFO_DIST_ENABLE: #{theme.welcomemap.dist.enable},
            INFO_TIME_CHANGE_ENABLE: #{theme.welcomemap.timeChange.enable},
            POSDESC_ENABLE: #{theme.welcomemap.welcome_posdesc.enable},
