    function getFocusTitle(type, originalTitle) {
        switch (type) {
            case FOCUS_TYPE.TYPE.LOST_TITLE:   return `!{theme.focus_title.lost_focus}`;
            case FOCUS_TYPE.TYPE.GAINED_TITLE: return `!{theme.focus_title.get_focus}`;
            default: return originalTitle;
        }
    }

