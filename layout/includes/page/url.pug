  #sssss
script.
  function getParameterByName(name) {
    name = name.replace(/[$$]/g, '\\$&');
    let url = window.location.href;
    let regex = new RegExp('[?&]' + name + '(=([^&#]*)|&|#|$)');
    let results = regex.exec(url);
    if (!results) return null;
    if (!results[2]) return '';
    return decodeURIComponent(results[2].replace(/\+/g, ' '));
  } // 巴拉巴拉一堆东西定义函数,取页面
  /*
  这个东东
  https://admincmd.xyz/url.html?url=[url]
  显示这个页面
  https://admincmd.xyz/url.html?url=[url]&yes=true
  显示这个页面并直接打开指定的 URL，yes 后面写true。
  */
  document.addEventListener('DOMContentLoaded', () => {
    let urlParam = getParameterByName('url'); // 获取 URL 参数
    let secnurl = getParameterByName('yes'); // 获取 URL 是否安全
    if (urlParam) {
      let Link = document.getElementById('link');
      Link.href = urlParam;
      Link.textContent = '' + urlParam;
    } else {
      document.getElementById('link').textContent = 'ERROR: URL 参数未找到(0x00)';
      // 冇得参数时显示报错信息
    }
    if (secnurl) { // 若有参数，则打开指定的 URL
      document.getElementById('sssss') = '<meta http-equiv="refresh" content="0;url=https://blog.admincmd.xyz">';
    }
  });